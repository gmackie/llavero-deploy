{
  "compatibility_date": "2026-09-01",
  "jsx_factory": "React.createElement",
  "jsx_fragment": "React.Fragment",
  "rules": [
    {
      "type": "ESModule",
      "globs": [
        "**/*.js",
        "**/*.mjs"
      ]
    }
  ],
  "name": "llavero",
  "main": "server/index.js",
  "triggers": {
    "crons": [
      "0 3 * * *",
      "*/5 * * * *"
    ]
  },
  "assets": {
    "directory": "client"
  },
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "STAGE": "production",
    "LLAVERO_AGENT_CLIENT_IDS": "",
    "LLAVERO_REGISTRY": "{\"credentials\":[],\"bindings\":[]}"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "VAULT",
        "class_name": "LlaveroVault"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "LlaveroVault"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "llavero",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMIT_AUTH",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "RATE_LIMIT_CONTACT",
      "namespace_id": "1002",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "RATE_LIMIT_API_KEYS",
      "namespace_id": "1003",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "RATE_LIMIT_OPERATOR_API",
      "namespace_id": "1004",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  },
  "$schema": "node_modules/wrangler/config-schema.json"
}
